{
  "name": "@veritystream/client",
  "version": "0.1.0",
  "description": "Lightweight, robust TypeScript client for VerityStream: real-time chat, AI token streaming, and chunked file uploads.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "veritystream",
    "websocket",
    "sse",
    "chat",
    "streaming",
    "llm-tokens",
    "chunked-upload"
  ],
  "author": "Kufre N Moses",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  }
}
