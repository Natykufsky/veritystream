{
  "name": "@veritystream/client",
  "version": "0.1.0",
  "description": "Lightweight TypeScript & React client for VerityStream (chat, AI tokens, chunked file sharing)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "tsc --noEmit"
  },
